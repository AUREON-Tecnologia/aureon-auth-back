# Server
PORT=3001
NODE_ENV=development

# Base de datos (Supabase Postgres, via Prisma). DATABASE_URL usa el pooler en
# modo transaccion (pgbouncer=true, puerto 6543) para runtime; DIRECT_URL usa
# conexion directa (puerto 5432) para `prisma db pull`/`migrate`. Las tablas de
# este servicio viven en el schema `auth` de la base de datos del proyecto
# (no el `public` por defecto) — ver CLAUDE.md.
DATABASE_URL="postgresql://usuario:password@host.pooler.supabase.com:6543/NOMBRE_BD?pgbouncer=true&schema=auth"
DIRECT_URL="postgresql://usuario:password@host.pooler.supabase.com:5432/NOMBRE_BD?schema=auth"

# JWT (DEBE coincidir con el gateway)
JWT_SECRET=super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN_DIAS=30

# Seguridad (RNF-008 - HU_04/HU_05, valores por defecto del equipo, ver CLAUDE.md)
AUTH_MAX_INTENTOS_FALLIDOS=5
AUTH_BLOQUEO_MINUTOS=15

# Self-service tokens: verificacion de email, reset de password, MFA setup (HU_13)
USER_TOKEN_EXPIRA_MINUTOS=30

# Plataforma multi-tenant (HU_13): protege POST /tenants; no hay rol de "super-admin"
# de plataforma en el schema, se usa un secreto compartido en su lugar.
PLATFORM_BOOTSTRAP_KEY=cambiar-por-un-secreto-largo-solo-para-devops
PLATFORM_DEFAULT_ROLE_CODE=cliente

# App
SERVICE_NAME=auth-service

# Redis (blacklist de tokens revocados via logout, ver @aureon/redis-client).
# Identity es el unico servicio que ESCRIBE en Redis; el resto de microservicios
# solo leen (mismo host/puerto, REDIS_KEY_PREFIX propio de cada uno).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=identity
