# Server
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# JWT (DEBE coincidir con el gateway)
JWT_SECRET=super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN_DIAS=30

# Seguridad (RNF-008 - HU_04/HU_05, valores por defecto del equipo, ver CLAUDE.md)
AUTH_MAX_INTENTOS_FALLIDOS=5
AUTH_BLOQUEO_MINUTOS=15

# OTP (RNF-006 - HU_08/HU_09)
OTP_EXPIRA_MINUTOS=5

# App
SERVICE_NAME=auth-service
