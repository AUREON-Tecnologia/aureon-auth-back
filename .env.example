# Server
PORT=3001
NODE_ENV=development

# Base de datos (Supabase Postgres, via Prisma). DATABASE_URL usa el pooler en
# modo transaccion (pgbouncer=true, puerto 6543) para runtime; DIRECT_URL usa
# conexion directa (puerto 5432) para `prisma db pull`/`migrate`. Las tablas de
# este servicio viven en el schema `auth` de la base de datos del proyecto
# (no el `public` por defecto) — ver CLAUDE.md.
DATABASE_URL="postgresql://usuario:password@host.pooler.supabase.com:6543/NOMBRE_BD?pgbouncer=true&schema=auth"
DIRECT_URL="postgresql://usuario:password@host.pooler.supabase.com:5432/NOMBRE_BD?schema=auth"

# JWT (DEBE ser identico en todos los microservicios AUREON que lo verifiquen)
JWT_SECRET=super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN_DIAS=30

# Seguridad (RNF-008 - HU_04/HU_05, valores por defecto del equipo, ver CLAUDE.md)
AUTH_MAX_INTENTOS_FALLIDOS=5
AUTH_BLOQUEO_MINUTOS=15

# Self-service tokens: verificacion de email, reset de password, MFA setup (HU_13)
USER_TOKEN_EXPIRA_MINUTOS=30

# Plataforma multi-tenant (HU_13): protege POST /tenants; no hay rol de "super-admin"
# de plataforma en el schema, se usa un secreto compartido en su lugar.
PLATFORM_BOOTSTRAP_KEY=cambiar-por-un-secreto-largo-solo-para-devops
PLATFORM_DEFAULT_ROLE_CODE=cliente

# App
SERVICE_NAME=auth-service

# Redis (whitelist de sesiones de access token, fail-closed, ver @aureon/redis-client).
# Identity es el unico servicio que ESCRIBE en Redis; el resto de microservicios
# solo leen (mismo host/puerto, REDIS_KEY_PREFIX propio de cada uno). Ya NO es
# opcional: sin Redis (o si REDIS_HOST no resuelve) login/refresh fallan con 503
# y ningun endpoint protegido por JwtAuthGuard puede validar tokens.
#
# Local/dev: usar el `redis` de docker-compose.yml (localhost:6379). Los valores
# del Redis desplegado (Railway, red privada `*.railway.internal`) se cargan como
# variables de entorno del servicio en la plataforma de despliegue, no aca.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=identity

# Cookies de sesion httpOnly (access_token/refresh_token/csrf_token, ver CLAUDE.md,
# seccion "Autenticacion por cookie"). COOKIE_DOMAIN queda vacio mientras cada
# microservicio siga en su propio dominio Railway sin relacion con los demas —
# se setea a algo como ".aureon.app" el dia que exista un dominio raiz compartido
# con cada servicio en su propio subdominio (unica forma de que la cookie de
# Identity sea visible para clientes-back/taller sin un componente intermediario).
#
# COOKIE_SAMESITE=none (no "lax"): mientras el frontend y los backends esten en
# dominios Railway sueltos sin relacion, toda request del navegador es cross-site
# — "lax" nunca mandaria la cookie en fetch/XHR. Pasar a "lax" cuando exista
# dominio raiz compartido. cookie.config.ts ya trae este default hardcodeado
# (mismo valor) por si esta env var no esta seteada en el entorno de despliegue.
COOKIE_DOMAIN=
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Origen exacto del frontend, para CORS con credentials (obligatorio: no hay
# wildcard valido junto con credentials:true). Debe coincidir con FRONTEND_ORIGIN
# de los demas microservicios que el mismo frontend consuma. cookie.config.ts
# trae este mismo valor hardcodeado como fallback si la env var no esta seteada.
FRONTEND_ORIGIN=https://aureonshellfront-production.up.railway.app

# Si esta en "true", CORS se abre a cualquier origen (refleja el Origin de cada
# request en vez de usar FRONTEND_ORIGIN) — util en dev para no tener que hacer
# coincidir el origin exacto del cliente. NO seteada aca a proposito: su default
# ya depende de NODE_ENV (ver app.config.ts) — abierto fuera de "production",
# cerrado en "production" aunque esta variable nunca se configure en Railway.
# Setear "true"/"false" explicito solo si hace falta pisar ese default.
# CORS_ALLOW_ALL_ORIGINS=true
